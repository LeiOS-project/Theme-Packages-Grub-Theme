#!/bin/sh
# postrm for leios.theme.grub-theme
# Rebuilds the GRUB configuration without the LeiOS theme.
#
# The desktop-grub alternative is removed by the debhelper-generated prerm.
# /etc/default/grub.d/leios-theme.cfg stays until purge but does nothing once
# the theme files are gone.

set -e

grub_update() {
    command -v update-grub >/dev/null 2>&1 || return 0
    if command -v systemd-detect-virt >/dev/null 2>&1 &&
       systemd-detect-virt --quiet --container; then
        return 0
    fi
    [ -e /boot/grub/grub.cfg ] || return 0

    update-grub || echo "WARNING: update-grub failed; please run it manually to remove the theme" >&2
}

case "$1" in
    remove|disappear)
        grub_update
    ;;

    purge|upgrade|failed-upgrade|abort-install|abort-upgrade)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
